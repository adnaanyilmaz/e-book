---
import type { GetStaticPaths } from 'astro';
import TemelLayout from '@/layouts/TemelLayout.astro';
import TarifListesi from '@/components/TarifListesi.astro';
import { yayindakiTarifler } from '@/lib/tarifler';
import { kategoriAdlari, type Kategori } from '@/site.config';

export const getStaticPaths = (async () => {
  const tarifler = await yayindakiTarifler();
  const kullanilanKategoriler = [...new Set(tarifler.map((t) => t.data.kategori))];
  // Sadece tarifi olan kategoriler için sayfa üretilir (boş sayfa = kötü SEO).
  return kullanilanKategoriler.map((kategori) => ({
    params: { kategori },
    props: { kategori, kullanilanKategoriler, tarifler: tarifler.filter((t) => t.data.kategori === kategori) },
  }));
}) satisfies GetStaticPaths;

const { kategori, kullanilanKategoriler, tarifler } = Astro.props as {
  kategori: Kategori;
  kullanilanKategoriler: Kategori[];
  tarifler: Awaited<ReturnType<typeof yayindakiTarifler>>;
};
const ad = kategoriAdlari[kategori];
---

<TemelLayout baslik={`${ad} Tarifleri`} aciklama={`Naif Mutfak ${ad.toLocaleLowerCase('tr-TR')} tarifleri: evde kolayca yapabileceğin sade ve lezzetli ev yemekleri.`}>
  <TarifListesi
    baslik={ad}
    giris={`${ad} kategorisindeki tüm tarifler.`}
    tarifler={tarifler}
    kullanilanKategoriler={kullanilanKategoriler}
    aktifKategori={kategori}
  />
</TemelLayout>
