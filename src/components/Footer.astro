---
import { Image } from 'astro:assets';
import logo from '@/assets/logo.png';
import { site } from '@/site.config';
import type { Dil } from '@/i18n/diller';
import { ceviri } from '@/i18n/ceviriler';
import { sayfaYolu, yasalAnahtarlar } from '@/i18n/yollar';

interface Props {
  dil: Dil;
}
const { dil } = Astro.props;
const t = ceviri(dil);
const yil = new Date().getFullYear();

const sayfalar = (['ana', 'blog', 'ekitap', 'hakkimda', 'iletisim'] as const).map((k) => ({
  href: sayfaYolu(dil, k),
  etiket: t.nav[k],
}));
const yasal = yasalAnahtarlar.map((k) => ({ href: sayfaYolu(dil, k), etiket: t.yasalAdlar[k] }));
---

<footer class="alt">
  <hr class="ayirici" />
  <div class="kapsayici alt__ic">
    <div class="alt__marka">
      <Image src={logo} alt="" width={88} height={88} densities={[1, 2]} class="alt__logo" />
      <p class="alt__ad">{site.ad}</p>
      <p>{t.site.slogan}. {t.altBilgi.metin}</p>
      <a class="buton buton--ikincil" href={site.instagram.url} target="_blank" rel="noopener">
        Instagram: <span dir="ltr">@{site.instagram.kullanici}</span>
      </a>
    </div>
    <nav aria-label={t.altBilgi.siteHaritasi}>
      <p class="alt__baslik">{t.altBilgi.sayfalar}</p>
      <ul>{sayfalar.map((l) => <li><a href={l.href}>{l.etiket}</a></li>)}</ul>
    </nav>
    <nav aria-label={t.altBilgi.yasal}>
      <p class="alt__baslik">{t.altBilgi.yasal}</p>
      <ul>{yasal.map((l) => <li><a href={l.href}>{l.etiket}</a></li>)}</ul>
    </nav>
  </div>
  <p class="kapsayici alt__telif">© {yil} {site.ad}. {t.altBilgi.haklar}</p>
</footer>

<style>
  .alt { margin-top: 3rem; background: var(--krem-koyu); }
  .alt__ic { display: grid; gap: 2rem; padding-block: 2.5rem 1.5rem; }
  .alt__logo { width: 88px; height: 88px; border-radius: 50%; margin-bottom: 0.75rem; }
  .alt__ad { font-family: var(--font-baslik); font-size: 1.5rem; color: var(--kahve); margin-bottom: 0.25rem; }
  .alt__baslik { font-weight: 800; color: var(--kahve); margin-bottom: 0.25rem; }
  .alt ul { list-style: none; padding: 0; margin: 0; }
  .alt li a { display: inline-flex; align-items: center; min-height: 40px; color: var(--metin); text-decoration: none; }
  .alt li a:hover { color: var(--terakota-koyu); text-decoration: underline; }
  .alt__telif { font-size: 0.85rem; color: var(--metin-soluk); padding-block: 1rem 2rem; margin: 0; }
  @media (min-width: 760px) { .alt__ic { grid-template-columns: 2fr 1fr 1fr; } }
</style>
