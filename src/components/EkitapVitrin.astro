---
import { Image } from 'astro:assets';
import { gorsel } from '@/lib/gorsel';
import { ekitap } from '@/site.config';
import { fiyatBicimle, type Dil } from '@/i18n/diller';
import { ceviri, doldur } from '@/i18n/ceviriler';
import { sayfaYolu } from '@/i18n/yollar';

interface Props {
  dil: Dil;
}
const { dil } = Astro.props;
const t = ceviri(dil);
const kapak = gorsel(t.ekitap.kapak);
const k = ekitap.satis[ekitap.dilKanali[dil]];
---

<section class="vitrin" aria-labelledby="vitrin-baslik">
  <div class="vitrin__kapak">
    <Image src={kapak} alt={doldur(t.ekitap.kapakAlt, { baslik: t.ekitap.baslik })} widths={[280, 420]} sizes="(min-width: 760px) 280px, 60vw" />
  </div>
  <div class="vitrin__metin">
    <span class="ust-baslik">{t.vitrin.ust}</span>
    <h2 id="vitrin-baslik">{t.ekitap.baslik}</h2>
    <p>{t.ekitap.altBaslik}. {t.vitrin.ek}</p>
    <p class="vitrin__fiyat">
      {k.eskiFiyat && <s>{fiyatBicimle(dil, k.eskiFiyat, k.paraBirimi)}</s>}
      <strong>{fiyatBicimle(dil, k.fiyat, k.paraBirimi)}</strong>
    </p>
    <a class="buton" href={sayfaYolu(dil, 'ekitap')}>{t.vitrin.incele}</a>
  </div>
</section>

<style>
  .vitrin {
    display: grid; gap: 1.5rem; align-items: center;
    background: var(--adacayi-acik); border-radius: calc(var(--yaricap) * 1.5);
    padding: clamp(1.5rem, 5vw, 3rem);
  }
  .vitrin__kapak { justify-self: center; width: min(60vw, 260px); }
  .vitrin__kapak img { border-radius: 6px 14px 14px 6px; box-shadow: 10px 12px 0 -2px rgb(91 58 41 / 0.15), var(--golge); transform: rotate(-2deg); }
  .vitrin__fiyat { font-size: 1.5rem; font-family: var(--font-baslik); color: var(--kahve); display: flex; gap: 0.75rem; align-items: baseline; }
  .vitrin__fiyat s { font-size: 1.1rem; color: var(--metin-soluk); }
  @media (min-width: 760px) { .vitrin { grid-template-columns: auto 1fr; gap: 3rem; } }
</style>
