---
import TarifKarti from './TarifKarti.astro';
import { kategoriler, type Kategori } from '@/site.config';
import type { Dil } from '@/i18n/diller';
import { ceviri } from '@/i18n/ceviriler';
import { kategoriYolu, sayfaYolu } from '@/i18n/yollar';
import type { Tarif } from '@/lib/tarifler';

interface Props {
  dil: Dil;
  baslik: string;
  giris: string;
  tarifler: Tarif[];
  /** Bu dilde en az bir tarifi olan kategoriler (filtre butonları) */
  kullanilanKategoriler: Kategori[];
  aktifKategori?: Kategori;
}
const { dil, baslik, giris, tarifler, kullanilanKategoriler, aktifKategori } = Astro.props;
const t = ceviri(dil);
const filtreler = kategoriler.filter((k) => kullanilanKategoriler.includes(k));
---

<section class="kapsayici bolum">
  <span class="ust-baslik">{t.blog.ust}</span>
  <h1>{baslik}</h1>
  <p class="giris">{giris}</p>

  <nav class="filtre" aria-label={t.blog.kategorilerEtiket}>
    <a href={sayfaYolu(dil, 'blog')} class="rozet" aria-current={!aktifKategori ? 'page' : undefined}>{t.blog.tumu}</a>
    {filtreler.map((k) => (
      <a href={kategoriYolu(dil, k)} class="rozet" aria-current={aktifKategori === k ? 'page' : undefined}>
        {t.kategoriler[k]}
      </a>
    ))}
  </nav>

  {tarifler.length > 0 ? (
    <div class="izgara">
      {tarifler.map((tarif, i) => <TarifKarti tarif={tarif} oncelikli={i === 0} />)}
    </div>
  ) : (
    <p>{t.blog.bos}</p>
  )}
</section>

<style>
  .giris { color: var(--metin-soluk); max-width: 36rem; }
  .filtre {
    display: flex; gap: 0.5rem; margin: 1.5rem 0 2rem;
    overflow-x: auto; padding-bottom: 0.5rem; scrollbar-width: none;
    margin-inline: calc(var(--kenar) * -1); padding-inline: var(--kenar);
  }
  .filtre::-webkit-scrollbar { display: none; }
  .filtre .rozet { min-height: 40px; padding-inline: 1rem; white-space: nowrap; flex-shrink: 0; }
  .filtre .rozet[aria-current='page'] { background: var(--terakota); color: var(--kagit); }
</style>
