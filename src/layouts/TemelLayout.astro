---
import '@fontsource-variable/fraunces';
import '@fontsource-variable/nunito';
import '@/styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import SEO, { type Props as SEOProps } from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props extends Omit<SEOProps, 'gorsel'> {
  /** Yerel görsel verilirse 1200x630 OG görseli otomatik üretilir */
  ogGorsel?: ImageMetadata;
  /** schema.org JSON-LD nesnesi */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { ogGorsel, jsonLd, ...seo } = Astro.props;

let gorsel: string | undefined;
if (ogGorsel) {
  const og = await getImage({ src: ogGorsel, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 });
  gorsel = og.src;
}
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fbf3e6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Naif Mutfak tarifleri" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} gorsel={gorsel} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="atla gizli" href="#icerik">İçeriğe geç</a>
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  .atla:focus {
    position: fixed; top: 0.5rem; left: 0.5rem; z-index: 50;
    width: auto; height: auto; clip: auto; padding: 0.75rem 1rem;
    background: var(--kahve); color: var(--kagit); border-radius: var(--yaricap-kucuk);
  }
</style>
