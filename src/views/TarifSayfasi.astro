---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import TemelLayout from '@/layouts/TemelLayout.astro';
import TarifKarti from '@/components/TarifKarti.astro';
import { site } from '@/site.config';
import { dilBilgisi, tarihBicimle, type Dil } from '@/i18n/diller';
import { ceviri, parcala } from '@/i18n/ceviriler';
import { kategoriYolu, sayfaYolu, type Alternatifler } from '@/i18n/yollar';
import type { Tarif } from '@/lib/tarifler';

interface Props {
  dil: Dil;
  alternatifler: Alternatifler;
  tarif: Tarif;
  benzerler: Tarif[];
}
const { dil, alternatifler, tarif, benzerler } = Astro.props;
const t = ceviri(dil);
const { Content } = await render(tarif);
const d = tarif.data;
const toplam = d.hazirlamaSuresi + (d.pisirmeSuresi ?? 0);

const jsonGorsel = await getImage({ src: d.kapak, width: 1200, format: 'jpg' });
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Recipe',
  name: d.baslik,
  description: d.aciklama,
  image: [new URL(jsonGorsel.src, Astro.site).href],
  datePublished: d.tarih.toISOString(),
  ...(d.guncelleme && { dateModified: d.guncelleme.toISOString() }),
  author: { '@type': 'Person', name: site.ad, url: site.instagram.url },
  recipeCategory: t.kategoriler[d.kategori],
  recipeCuisine: t.tarif.mutfak,
  prepTime: `PT${d.hazirlamaSuresi}M`,
  ...(d.pisirmeSuresi !== undefined && { cookTime: `PT${d.pisirmeSuresi}M` }),
  totalTime: `PT${toplam}M`,
  ...(d.porsiyon && { recipeYield: d.porsiyon }),
  ...(d.malzemeler && { recipeIngredient: d.malzemeler }),
  inLanguage: dilBilgisi[dil].bcp47,
};
---

<TemelLayout
  dil={dil}
  alternatifler={alternatifler}
  baslik={d.baslik}
  aciklama={d.aciklama}
  ogGorsel={d.kapak}
  gorselAlt={d.kapakAlt}
  tur="article"
  yayinTarihi={d.tarih}
  guncellemeTarihi={d.guncelleme}
  jsonLd={jsonLd}
>
  <article class="tarif">
    <header class="kapsayici tarif__ust">
      <nav class="ekmek" aria-label={t.tarif.konum}>
        <a href={sayfaYolu(dil, 'blog')}>{t.nav.blog}</a> / <a href={kategoriYolu(dil, d.kategori)}>{t.kategoriler[d.kategori]}</a>
      </nav>
      <h1>{d.baslik}</h1>
      <p class="tarif__ozet">{d.aciklama}</p>
      <p class="tarif__tarih">
        <time datetime={d.tarih.toISOString()}>{tarihBicimle(dil, d.tarih)}</time>
      </p>
    </header>

    <figure class="kapsayici tarif__sekil">
      <Image
        src={d.kapak}
        alt={d.kapakAlt}
        widths={[480, 800, 1200]}
        sizes="(min-width: 1100px) 1040px, 100vw"
        class="tarif__kapak"
        loading="eager"
        fetchpriority="high"
      />
      {d.kapakKaynak && (
        <figcaption class="tarif__kaynak">
          {parcala(t.tarif.fotoKaynak).map((p) =>
            'metin' in p ? p.metin
            : p.anahtar === 'yazar' ? <a href={d.kapakKaynak!.url} target="_blank" rel="noopener" dir="ltr">{d.kapakKaynak!.yazar}</a>
            : <a href={d.kapakKaynak!.lisansUrl} target="_blank" rel="noopener license" dir="ltr">{d.kapakKaynak!.lisans}</a>,
          )}
        </figcaption>
      )}
    </figure>

    <div class="kapsayici">
      <dl class="bilgi">
        <div><dt>{t.tarif.hazirlik}</dt><dd>{d.hazirlamaSuresi} {t.tarif.dk}</dd></div>
        {d.pisirmeSuresi !== undefined && <div><dt>{t.tarif.pisirme}</dt><dd>{d.pisirmeSuresi} {t.tarif.dk}</dd></div>}
        <div><dt>{t.tarif.toplam}</dt><dd>{toplam} {t.tarif.dk}</dd></div>
        {d.porsiyon && <div><dt>{t.tarif.porsiyon}</dt><dd>{d.porsiyon}</dd></div>}
      </dl>
    </div>

    <div class="kapsayici tarif__govde">
      {d.malzemeler && (
        <aside class="malzemeler" aria-labelledby="malzeme-baslik">
          <h2 id="malzeme-baslik">{t.tarif.malzemeler}</h2>
          <ul>{d.malzemeler.map((m) => <li>{m}</li>)}</ul>
        </aside>
      )}
      <div class="icerik">
        <Content />
      </div>
    </div>

    <div class="kapsayici">
      <div class="paylas">
        <p>
          {parcala(t.tarif.paylas).map((p) =>
            'anahtar' in p ? <strong dir="ltr">@{site.instagram.kullanici}</strong> : p.metin,
          )}
        </p>
        <a class="buton" href={site.instagram.url} target="_blank" rel="noopener">{t.tarif.paylasButon}</a>
      </div>
    </div>
  </article>

  {benzerler.length > 0 && (
    <section class="kapsayici bolum" aria-labelledby="benzer-baslik">
      <h2 id="benzer-baslik">{t.tarif.benzer}</h2>
      <div class="izgara">{benzerler.map((b) => <TarifKarti tarif={b} />)}</div>
    </section>
  )}
</TemelLayout>

<style>
  .tarif__ust { padding-block: 1.5rem 1.25rem; max-width: 52rem; }
  .ekmek { font-size: 0.9rem; color: var(--metin-soluk); margin-bottom: 0.75rem; }
  .ekmek a { color: inherit; }
  .tarif__ozet { font-size: 1.15rem; color: var(--metin-soluk); }
  .tarif__tarih { font-size: 0.9rem; color: var(--metin-soluk); margin: 0; }
  .tarif__kapak {
    width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--yaricap);
    margin-inline: auto; max-width: 65rem;
  }
  @media (min-width: 760px) { .tarif__kapak { aspect-ratio: 16 / 9; } }
  .tarif__sekil { margin-block: 0; }
  .tarif__kaynak {
    max-width: 65rem; margin: 0.4rem auto 0; font-size: 0.8rem; color: var(--metin-soluk); text-align: end;
  }
  .tarif__kaynak a { color: inherit; }

  .bilgi {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(6.5rem, 1fr)); gap: 0.5rem;
    margin: -1.5rem auto 2rem; position: relative; max-width: 40rem;
    background: var(--kagit); border: 1px solid var(--cizgi); border-radius: var(--yaricap);
    padding: 0.9rem; box-shadow: var(--golge); text-align: center;
    width: calc(100% - 1.5rem);
  }
  .bilgi dt { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--metin-soluk); font-weight: 800; }
  .bilgi dd { margin: 0; font-family: var(--font-baslik); font-size: 1.15rem; color: var(--kahve); }

  .tarif__govde { display: grid; gap: 2rem; max-width: 60rem; }
  .malzemeler {
    background: var(--adacayi-acik); border-radius: var(--yaricap); padding: 1.25rem 1.5rem;
    align-self: start;
  }
  .malzemeler h2 { font-size: 1.35rem; }
  .malzemeler ul { padding-inline-start: 1.1rem; margin: 0; }
  .malzemeler li { margin-bottom: 0.45rem; }
  .malzemeler li::marker { color: var(--adacayi); }
  @media (min-width: 860px) {
    .tarif__govde { grid-template-columns: 18rem 1fr; }
    .malzemeler { position: sticky; top: 5.5rem; }
  }

  .paylas {
    margin: 2.5rem auto 0; max-width: 60rem; text-align: center;
    padding: 1.5rem; border: 2px dashed var(--cizgi); border-radius: var(--yaricap);
  }
</style>
