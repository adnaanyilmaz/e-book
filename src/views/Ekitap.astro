---
import { Image, getImage } from 'astro:assets';
import TemelLayout from '@/layouts/TemelLayout.astro';
import kapak from '@/assets/ekitap-kapak.jpg';
import { ekitap, site } from '@/site.config';
import { fiyatBicimle, type Dil } from '@/i18n/diller';
import { ceviri, doldur, parcala } from '@/i18n/ceviriler';
import { sayfaYolu, type Alternatifler } from '@/i18n/yollar';

interface Props {
  dil: Dil;
  alternatifler: Alternatifler;
}
const { dil, alternatifler } = Astro.props;
const t = ceviri(dil);
const e = t.ekitap;
const kapakAlt = doldur(e.kapakAlt, { baslik: e.baslik });

const satinAlHazir = !ekitap.odemeLinki.startsWith('#');
const ogKapak = await getImage({ src: kapak, width: 1200, format: 'jpg' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: e.baslik,
  description: e.altBaslik,
  image: new URL(ogKapak.src, Astro.site).href,
  brand: { '@type': 'Brand', name: site.ad },
  offers: {
    '@type': 'Offer',
    price: ekitap.fiyat,
    priceCurrency: 'TRY',
    availability: 'https://schema.org/InStock',
    url: new URL(sayfaYolu(dil, 'ekitap'), Astro.site).href,
  },
};

const yasalLinkler = {
  mesafeli: { href: sayfaYolu(dil, 'mesafeli'), etiket: t.yasalAdlar.mesafeli },
  iade: { href: sayfaYolu(dil, 'iade'), etiket: t.yasalAdlar.iade },
} as Record<string, { href: string; etiket: string }>;
---

<TemelLayout
  dil={dil}
  alternatifler={alternatifler}
  baslik={doldur(e.seoBaslik, { baslik: e.baslik })}
  aciklama={doldur(e.seoAciklama, { altBaslik: e.altBaslik, format: ekitap.format })}
  ogGorsel={kapak}
  gorselAlt={kapakAlt}
  tur="product"
  jsonLd={jsonLd}
>
  <section class="urun">
    <div class="kapsayici urun__ic">
      <div class="urun__kapak">
        <Image
          src={kapak}
          alt={kapakAlt}
          widths={[320, 480, 640]}
          sizes="(min-width: 860px) 360px, 70vw"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="urun__metin">
        <span class="ust-baslik">{doldur(e.ust, { format: ekitap.format, sayfa: ekitap.sayfaSayisi })}</span>
        <h1>{e.baslik}</h1>
        <p class="urun__alt">{e.altBaslik}</p>
        {e.dilNotu && <p class="urun__dil">{e.dilNotu}</p>}
        <div class="satin-al" id="satin-al">
          <p class="fiyat">
            {ekitap.eskiFiyat && <s>{fiyatBicimle(dil, ekitap.eskiFiyat)}</s>}
            <strong>{fiyatBicimle(dil, ekitap.fiyat)}</strong>
          </p>
          <a
            class="buton buton--tam"
            href={ekitap.odemeLinki}
            target={satinAlHazir ? '_blank' : undefined}
            rel={satinAlHazir ? 'noopener' : undefined}
            aria-disabled={satinAlHazir ? undefined : 'true'}
          >
            {e.satinAl}
          </a>
          <p class="guvence">{satinAlHazir ? e.guvenli : e.yakinda}</p>
          <p class="yasal-not">
            {parcala(e.yasalNot).map((p) =>
              'anahtar' in p ? <a href={yasalLinkler[p.anahtar!]!.href}>{yasalLinkler[p.anahtar!]!.etiket}</a> : p.metin,
            )}
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="kapsayici bolum okuma" aria-labelledby="icindekiler">
    <span class="ust-baslik">{e.icindekilerUst}</span>
    <h2 id="icindekiler">{e.icindekiler}</h2>
    <ol class="bolumler">
      {e.bolumler.map((b) => (
        <li>
          <strong>{b.baslik}</strong>
          <span>{b.aciklama}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="kapsayici bolum okuma" aria-labelledby="sss">
    <h2 id="sss">{e.sssBaslik}</h2>
    {e.sss.map(({ s, c }) => (
      <details class="sss">
        <summary>{s}</summary>
        <p>{c}</p>
      </details>
    ))}
  </section>

  {/* Mobilde fiyat ve buton hep görünür kalsın (sadece ödeme linki girildiyse) */}
  {satinAlHazir && (
    <div class="yapiskan">
      <span class="yapiskan__fiyat">{fiyatBicimle(dil, ekitap.fiyat)}</span>
      <a class="buton" href={ekitap.odemeLinki} target="_blank" rel="noopener">{e.satinAl}</a>
    </div>
  )}
</TemelLayout>

<style>
  .urun { background: linear-gradient(180deg, var(--krem-koyu), var(--krem)); }
  .urun__ic { display: grid; gap: 2rem; padding-block: 2rem; align-items: center; }
  .urun__kapak { justify-self: center; width: min(70vw, 340px); }
  .urun__kapak img { border-radius: 6px 16px 16px 6px; box-shadow: 14px 16px 0 -4px rgb(91 58 41 / 0.15), var(--golge); }
  .urun__alt { font-size: 1.15rem; color: var(--metin-soluk); }
  .urun__dil { font-size: 0.9rem; color: var(--metin-soluk); font-style: italic; }

  .satin-al { background: var(--kagit); border: 1px solid var(--cizgi); border-radius: var(--yaricap); padding: 1.25rem; box-shadow: var(--golge); max-width: 26rem; }
  .fiyat { font-family: var(--font-baslik); font-size: 2rem; color: var(--kahve); display: flex; gap: 0.75rem; align-items: baseline; margin-bottom: 0.75rem; }
  .fiyat s { font-size: 1.2rem; color: var(--metin-soluk); }
  .satin-al .buton[aria-disabled='true'] { opacity: 0.6; pointer-events: none; }
  .guvence { font-size: 0.9rem; color: var(--metin-soluk); text-align: center; margin: 0.6rem 0 0.4rem; }
  .yasal-not { font-size: 0.8rem; color: var(--metin-soluk); margin: 0; }

  .bolumler { list-style: none; counter-reset: b; padding: 0; margin: 0; }
  .bolumler li {
    counter-increment: b; display: grid; gap: 0.15rem;
    padding-block: 1rem; padding-inline-start: 3.25rem; position: relative; border-bottom: 1px dashed var(--cizgi);
  }
  .bolumler li::before {
    content: counter(b); position: absolute; inset-inline-start: 0; top: 1rem;
    width: 2.25rem; height: 2.25rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--terakota); color: var(--kagit); font-family: var(--font-baslik); font-weight: 600;
  }
  .bolumler span { color: var(--metin-soluk); }

  .sss { border-bottom: 1px solid var(--cizgi); }
  .sss summary { cursor: pointer; font-weight: 700; padding: 0.9rem 0; min-height: 48px; color: var(--kahve); }
  .sss p { color: var(--metin-soluk); }

  .yapiskan {
    position: fixed; inset-inline: 0; bottom: 0; z-index: 15;
    display: flex; justify-content: space-between; align-items: center; gap: 1rem;
    padding: 0.6rem var(--kenar) calc(0.6rem + env(safe-area-inset-bottom));
    background: rgb(255 250 242 / 0.96); border-top: 1px solid var(--cizgi); backdrop-filter: blur(8px);
  }
  .yapiskan__fiyat { font-family: var(--font-baslik); font-size: 1.35rem; color: var(--kahve); }
  :global(body:has(.yapiskan)) { padding-bottom: 72px; }

  @media (min-width: 860px) {
    .urun__ic { grid-template-columns: auto 1fr; gap: 4rem; padding-block: 4rem; }
    .yapiskan { display: none; }
    :global(body:has(.yapiskan)) { padding-bottom: 0; }
  }
</style>
